{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node",
      "config": {
        "include": [
          "server/config/",
          "server/controllers/",
          "server/middleware/",
          "server/models/",
          "server/routes/",
          "server/utils/",
          "server/seed.js"
        ]
      }
    },
    {
      "src": "client/",
      "use": "@vercel/static",
      "config": {
        "include": ["client/dist/"],
        "exclude": ["client/node_modules/", "client/src/", "client/public/"],
        "framework": "vite"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/index.html"
    }
  ],
  "env": {
    "MONGO_URI": "@env.MONGODB_URI",
    "JWT_SECRET": "@env.JWT_SECRET",
    "PORT": "3000",
    "CLIENT_URL": "/"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": "512mb",
      "maxDuration": 30,
      "runtime": "nodejs22.x"
    }
  },
  "preview": {
    "disableLogging": true
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
